name: Build APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Arrange project
        run: |
          mkdir -p app/src/main/java/com/gsgroup/bmwdash app/src/main/assets/img
          mv app-build.gradle app/build.gradle
          mv AndroidManifest.xml app/src/main/
          mv MainActivity.java app/src/main/java/com/gsgroup/bmwdash/
          mv index.html app/src/main/assets/
          mv t*.webp app/src/main/assets/img/
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.2
      - run: gradle assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: BMW-Dashboard-APK
          path: app/build/outputs/apk/debug/app-debug.apk
